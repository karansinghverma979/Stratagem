# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows scripts and installers
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.nsh text eol=crlf
*.nsi text eol=crlf

# Shell scripts
*.sh text eol=lf

# Source & Config files
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.svelte text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary media and database formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.node binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.woff binary
*.woff2 binary
*.ttf binary
*.mp3 binary
*.wav binary
